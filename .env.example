# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development

# Azure AD Authentication (for user login to the web app)
AZURE_AD_CLIENT_ID=your-web-app-client-id
AZURE_AD_CLIENT_SECRET=your-web-app-client-secret
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_REDIRECT_URI=http://localhost:5000/auth/callback

# Fabric SQL Connection (Service Principal for database access)
FABRIC_CLIENT_ID=your-service-principal-client-id
FABRIC_TENANT_ID=your-tenant-id
FABRIC_CLIENT_SECRET=your-service-principal-client-secret
FABRIC_SERVER=your-fabric-server.database.fabric.microsoft.com
FABRIC_DATABASE=your-database-name

# API Authentication (for programmatic access from other apps)
# Format: "APP_NAME:api_key,APP_NAME2:api_key2"
# Generate secure keys using: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=APP1:your-api-key-here,APP2:another-api-key-here
